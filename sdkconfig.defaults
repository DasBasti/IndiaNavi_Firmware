# ESP-IDF settings of all builds that differ from the ESP-IDF defaults.
#
# The sdkconfig.<env> files are generated from these when they are missing:
#   sdkconfig.defaults              all builds
#   sdkconfig.defaults.<chip>       added by ESP-IDF for the chip (esp32s3, esp32)
#   sdkconfig.defaults.<env>        set per environment in platformio.ini
# A setting in an existing sdkconfig.<env> (from menuconfig) wins over these. To make
# a change permanent, put it here and delete sdkconfig.<env>. The sdkconfig.<env>
# files are not in git.

CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_FATFS_LFN_NONE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_LOG_COLORS=y
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_MBEDTLS_LARGE_KEY_SOFTWARE_MPI=n
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_THREADING_C=n
CONFIG_PM_ENABLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_VFS_SUPPORT_TERMIOS=y
